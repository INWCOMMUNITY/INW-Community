# Shopify Marketplace V2 (S1 connection). Admin API version is pinned in code (2026-07).
# Public app base URL with no path. Callback and uninstall webhook are derived from it.
# Tokens are encrypted with ENCRYPTION_KEY. OAuth state is signed with NEXTAUTH_SECRET.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_APP_URL="http://localhost:3000"
# --- END 3RD PARTY MARKETPLACE SYNC ---

# Cloudinary – cloud name from dashboard (e.g. djmi9rod0). Required for thanks image, directory background, etc.
# Admin-replaced site images are routed through Cloudinary with AI upscale; add your domain and *.blob.vercel-storage.com to Allowed fetch sites in Cloudinary if needed.
CLOUDINARY_CLOUD_NAME=""

# Cloudinary – high-res thanks photo. Upload thanks-landscape.png to Media Library, set public_id (e.g. thanks-landscape)
NEXT_PUBLIC_CLOUDINARY_THANKS_IMAGE=""

# Cloudinary – business directory header background. Public ID from Media Library (e.g. background_lv6evz)
NEXT_PUBLIC_CLOUDINARY_DIRECTORY_BACKGROUND="background_lv6evz"

# --- Local dev = same APIs as live (optional) ---
# The app does not force “test” mode when NODE_ENV=development — Stripe/Shippo use whatever keys you set.
# To match www production while running pnpm dev: put sk_live_/pk_live_, live price IDs, shippo_live_ SHIPPO_API_KEY,
# and (if needed) production DATABASE_URL in root .env. Keep NEXTAUTH_URL=http://localhost:3000 so cookies and
# OAuth work in the browser on localhost; add localhost URLs in Stripe Dashboard if you use live keys locally.

# --- Production / Go live ---
# Main: Use live Stripe keys (sk_live_..., pk_live_...) and live price IDs. Set NEXTAUTH_URL to prod URL.
# Main: BLOB_READ_WRITE_TOKEN for site image uploads (Vercel Blob).
# Admin: Set NEXT_PUBLIC_MAIN_SITE_URL to your main site URL (e.g. https://northwestcommunity.com).
# Admin: Set a strong unique ADMIN_CODE (server only). Browser login uses /api/admin/session.
# Both: Use production DATABASE_URL. Run db:seed once if needed.

# --- Live direct messaging (Socket.IO service) ---
# Web and native app use the SAME realtime server and rooms — set the SAME public URL on website + mobile:
#   NEXT_PUBLIC_REALTIME_URL  (Next / browser)  ===  EXPO_PUBLIC_REALTIME_URL  (Expo build)
# so a user on inwcommunity.com and a user on the iOS/Android app receive each other's messages, typing, and presence.
# Run alongside Next: pnpm dev:realtime  (default port 3007). Main app publishes events after each direct message.
# Local dev: optional — main + realtime default to http://127.0.0.1:3007 and NEXTAUTH_SECRET for /internal/publish when unset.
# Production: set both explicitly (do not rely on NEXTAUTH_SECRET for publish).
# REALTIME_PUBLISH_URL="http://127.0.0.1:3007"
# REALTIME_PUBLISH_SECRET="generate-with-openssl-rand-base64-32"
# Optional: comma-separated origins for browser/mobile clients (defaults include localhost + www.inwcommunity.com).
# REALTIME_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://www.inwcommunity.com"
# Website Socket.IO base. If you use http://127.0.0.1:3007 but open the site at http://YOUR_LAN_IP:3000, the app now rewrites the host to match the page (so typing/messages work on phones on Wi‑Fi).
# Production: NEXT_PUBLIC_REALTIME_URL="https://your-realtime-host.example"
# Mobile release: EXPO_PUBLIC_REALTIME_URL="https://your-realtime-host.example" (same WSS-capable origin as NEXT_PUBLIC_REALTIME_URL)
# Realtime service only: REDIS_URL for multi-instance pub/sub (optional). REALTIME_METRICS_SECRET to protect GET /internal/metrics
#
# --- Deploy checklist (live messaging) ---
# Vercel (main): NEXT_PUBLIC_REALTIME_URL, REALTIME_PUBLISH_URL, REALTIME_PUBLISH_SECRET (match Railway realtime).
# Railway (realtime): REALTIME_PUBLISH_SECRET, NEXTAUTH_SECRET, optional REDIS_URL for >1 instance.
# Expo EAS / mobile .env: EXPO_PUBLIC_REALTIME_URL same origin as NEXT_PUBLIC_REALTIME_URL.
# Verify (dev: open GET /api/realtime/config-check; prod: admin session or x-admin-code): publishPipelineLikelyWorks should be true.