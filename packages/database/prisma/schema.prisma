  question  String
  options   PostPollOption[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("post_poll")
}

model PostPollOption {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  poll   PostPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  votes  PostPollVote[]

  @@index([pollId])
  @@map("post_poll_option")
}

model PostPollVote {
  id       String   @id @default(cuid())
  optionId String   @map("option_id")
  option   PostPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  memberId String   @map("member_id")
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([optionId, memberId])
  @@index([memberId])
  @@map("post_poll_vote")
