}

// Seller analytics: listing views, cart adds, purchases, offer events
model SellerAnalyticsEvent {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id") // The seller whose listing was viewed/interacted with
  storeItemId String?  @map("store_item_id")
  eventType   String   @map("event_type") // listing_view, storefront_view, cart_add, purchase, offer_received
  provider    String?  // ebay, etsy, shopify, wix, inwc (source channel)
  source      String?  // web, mobile, external
  metadata    Json?    // Additional event data (visitor info, etc.)
  createdAt   DateTime @default(now()) @map("created_at")

  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeItem StoreItem? @relation(fields: [storeItemId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
  @@index([storeItemId, eventType])
  @@map("seller_analytics_event")
}

// Seller activity log: comprehensive audit trail for seller actions
model SellerActivityLog {
  id         String   @id @default(cuid())
  memberId   String   @map("member_id")
  action     String   // item_created, item_updated, item_deleted, bulk_edit, bulk_publish,
                      // channel_linked, channel_unlinked, order_received, offer_received,
                      // payout_requested, low_stock_alert, sync_error
  entityType String   @map("entity_type") // store_item, channel_link, order, payout
  entityId   String?  @map("entity_id")
  detail     Json?    // Structured details (before/after for edits, affected item IDs, etc.)
  metadata   Json?    // Additional context (source, user agent, etc.)
  createdAt  DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([entityType, entityId])
  @@map("seller_activity_log")
}

// Bulk edit snapshots for undo capability (24-hour window)
model BulkEditSnapshot {
  id        String    @id @default(cuid())
  memberId  String    @map("member_id")
  operation String    // bulk_edit, bulk_publish, bulk_unpublish, bulk_delete
  itemCount Int       @map("item_count")
  changes   Json      // { itemId: { before: {...}, after: {...} } }
  canUndo   Boolean   @default(true) @map("can_undo")
  undoneAt  DateTime? @map("undone_at")
  expiresAt DateTime  @map("expires_at") // 24 hours from creation
  createdAt DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([expiresAt])
  @@map("bulk_edit_snapshot")
}

// Post polls - attach a single poll to a post
model PostPoll {
