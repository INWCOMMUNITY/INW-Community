/// Shopify Marketplace V2 connection lifecycle. Historical generations are retained.
enum ShopifyConnectionStatus {
  ACTIVE
  DISCONNECTED
  REVOKED

  @@map("shopify_connection_status")
}

/// One-time OAuth state. Consumed on callback; not a connection.
model ShopifyOAuthState {
  id                 String    @id @default(cuid())
  nonce              String    @unique
  memberId           String    @map("member_id")
  shopDomain         String    @map("shop_domain")
  /// SHA-256 hex of the HttpOnly browser-binding cookie. The raw secret is never stored.
  browserBindingHash String    @map("browser_binding_hash") @db.VarChar(64)
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, shopDomain])
  @@index([expiresAt])
  @@map("shopify_oauth_state")
}

/// One generation of a member's Shopify install.
/// Partial unique indexes in migration SQL, which Prisma cannot express:
/// one ACTIVE row per member + shop, one ACTIVE row per shop domain, and one ACTIVE row per Shop GID.
model ShopifyConnection {
  id                    String                   @id @default(cuid())
  memberId              String                   @map("member_id")
  shopDomain            String                   @map("shop_domain")
  shopId                String                   @map("shop_id")
  generation            Int
  accessTokenEncrypted  String                   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String                   @map("refresh_token_encrypted") @db.Text
  accessTokenExpiresAt  DateTime                 @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime                 @map("refresh_token_expires_at")
  grantedScopes         String                   @map("granted_scopes") @db.Text
  status                ShopifyConnectionStatus
  primaryLocationId     String?                  @map("primary_location_id")
  connectedAt           DateTime                 @map("connected_at")
  disconnectedAt        DateTime?                @map("disconnected_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  member      Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  listingLinks ShopifyListingLink[]
  variantMaps  ShopifyVariantMap[]
  providerEvidence ShopifyProviderEvidence[]
  syncJobs         ShopifySyncJob[]
  orderLineSaleFacts ShopifyOrderLineSaleFact[]

  /// Supports composite FKs from mapping rows so connection + member cannot drift.
  @@unique([id, memberId])
  @@unique([memberId, shopDomain, generation])
  @@index([memberId, status])
  @@index([shopDomain, status])
  @@map("shopify_connection")
}

/// Generation-bound StoreItem ↔ Shopify Product mapping. Bound to ShopifyConnection.id.
model ShopifyListingLink {
  id                           String    @id @default(cuid())
  shopifyConnectionId          String    @map("shopify_connection_id")
  memberId                     String    @map("member_id")
  storeItemId                  String    @map("store_item_id")
  shopifyProductId             String    @map("shopify_product_id")
  /// S5: monotonic desired product content version (title/description).
  desiredProductContentVersion Int       @default(0) @map("desired_product_content_version")
  /// S5: last successfully applied product content version.
  appliedProductContentVersion Int       @default(0) @map("applied_product_content_version")
  desiredProductFingerprint    String?   @map("desired_product_fingerprint") @db.VarChar(64)
  appliedProductFingerprint    String?   @map("applied_product_fingerprint") @db.VarChar(64)
  productContentAppliedAt      DateTime? @map("product_content_applied_at")
  /// S6: when the latest INW product content desire was recorded.
  productDesiredAt               DateTime? @map("product_desired_at")
  lastObservedProductFingerprint String?   @map("last_observed_product_fingerprint") @db.VarChar(64)
  lastObservedProductUpdatedAt   DateTime? @map("last_observed_product_updated_at")
  /// S6 repair: unresolved dual-divergence product content conflict.
  productContentConflict           Boolean   @default(false) @map("product_content_conflict")
  productConflictRemoteFingerprint String?   @map("product_conflict_remote_fingerprint") @db.VarChar(64)
  productConflictEvidenceId        String?   @map("product_conflict_evidence_id")
  productConflictDetectedAt        DateTime? @map("product_conflict_detected_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  connection  ShopifyConnection   @relation(fields: [shopifyConnectionId, memberId], references: [id, memberId], onDelete: Restrict)
  storeItem   StoreItem           @relation(fields: [storeItemId, memberId], references: [id, memberId], onDelete: Restrict)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  variantMaps ShopifyVariantMap[]

  @@unique([shopifyConnectionId, storeItemId])
  @@unique([shopifyConnectionId, shopifyProductId])
  /// Supports composite FKs from ShopifyVariantMap so connection/item cannot drift.
  @@unique([id, shopifyConnectionId, storeItemId])
  @@index([memberId, storeItemId])
  @@map("shopify_listing_link")
}

/// Generation-bound StoreVariant ↔ Shopify ProductVariant + InventoryItem mapping.
model ShopifyVariantMap {
  id                           String    @id @default(cuid())
  shopifyConnectionId          String    @map("shopify_connection_id")
  shopifyListingLinkId         String    @map("shopify_listing_link_id")
  memberId                     String    @map("member_id")
  storeItemId                  String    @map("store_item_id")
  storeVariantId               String    @map("store_variant_id")
  shopifyVariantId             String    @map("shopify_variant_id")
  shopifyInventoryItemId       String    @map("shopify_inventory_item_id")
  /// S5: monotonic desired variant content version (price/SKU).
  desiredVariantContentVersion Int       @default(0) @map("desired_variant_content_version")
  /// S5: last successfully applied variant content version.
  appliedVariantContentVersion Int       @default(0) @map("applied_variant_content_version")
  desiredVariantFingerprint    String?   @map("desired_variant_fingerprint") @db.VarChar(64)
  appliedVariantFingerprint    String?   @map("applied_variant_fingerprint") @db.VarChar(64)
  variantContentAppliedAt      DateTime? @map("variant_content_applied_at")
  /// S6: when the latest INW variant content desire was recorded.
  variantDesiredAt               DateTime? @map("variant_desired_at")
  lastObservedVariantFingerprint String?   @map("last_observed_variant_fingerprint") @db.VarChar(64)
  lastObservedVariantUpdatedAt   DateTime? @map("last_observed_variant_updated_at")
  /// S6 repair: unresolved dual-divergence variant content conflict.
  variantContentConflict           Boolean   @default(false) @map("variant_content_conflict")
  variantConflictRemoteFingerprint String?   @map("variant_conflict_remote_fingerprint") @db.VarChar(64)
  variantConflictEvidenceId        String?   @map("variant_conflict_evidence_id")
  variantConflictDetectedAt        DateTime? @map("variant_conflict_detected_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  connection   ShopifyConnection  @relation(fields: [shopifyConnectionId, memberId], references: [id, memberId], onDelete: Restrict)
  listingLink  ShopifyListingLink @relation(fields: [shopifyListingLinkId, shopifyConnectionId, storeItemId], references: [id, shopifyConnectionId, storeItemId], onDelete: Restrict)
  storeVariant StoreVariant       @relation(fields: [storeVariantId, storeItemId, memberId], references: [id, storeItemId, memberId], onDelete: Restrict)
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([shopifyConnectionId, storeVariantId])
  @@unique([shopifyConnectionId, shopifyVariantId])
  @@unique([shopifyConnectionId, shopifyInventoryItemId])
  @@index([shopifyListingLinkId])
  @@map("shopify_variant_map")
}

enum ShopifyEvidenceProcessState {
  RECEIVED
  PROCESSED
  IGNORED
  ERROR

  @@map("shopify_evidence_process_state")
}

enum ShopifyOrderLineSaleApplyState {
  PENDING
  APPLIED
  UNMAPPED
  FAILED

  @@map("shopify_order_line_sale_apply_state")
}

enum ShopifySyncJobState {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  DEAD

  @@map("shopify_sync_job_state")
}

enum ShopifySyncJobKind {
  PROCESS_PROVIDER_EVIDENCE
  CREATE_LISTING
  UPDATE_LISTING_CONTENT

  @@map("shopify_sync_job_kind")
}

/// Verified inbound Shopify webhook fact. Separate from canonical commerce state.
model ShopifyProviderEvidence {
  id                  String                      @id @default(cuid())
  shopifyConnectionId String?                     @map("shopify_connection_id")
  shopDomain          String                      @map("shop_domain")
  topic               String
  /// X-Shopify-Webhook-Id. Delivery dedupe identity.
  webhookId           String                      @unique @map("webhook_id")
  /// X-Shopify-Event-Id when present. Not unique across deliveries.
  eventId             String?                     @map("event_id")
  triggeredAt         DateTime                    @map("triggered_at")
  apiVersion          String?                     @map("api_version")
  rawBody             String                      @map("raw_body") @db.Text
  payloadHash         String                      @map("payload_hash") @db.VarChar(64)
  processState        ShopifyEvidenceProcessState @default(RECEIVED) @map("process_state")
  receivedAt          DateTime                    @default(now()) @map("received_at")
  processedAt         DateTime?                   @map("processed_at")
  lastErrorCode       String?                     @map("last_error_code")
  lastErrorMessage    String?                     @map("last_error_message") @db.Text
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  connection ShopifyConnection? @relation(fields: [shopifyConnectionId], references: [id], onDelete: Restrict)
  syncJob    ShopifySyncJob?
  orderLineSaleFacts ShopifyOrderLineSaleFact[]

  @@index([shopifyConnectionId, topic, receivedAt])
  @@index([processState, receivedAt])
  @@index([shopDomain, triggeredAt])
  @@index([eventId])
  @@map("shopify_provider_evidence")
}

/// Durable Shopify paid order-line sale fact. Not an INW StoreOrder.
/// Exactly-once inventory causality key: (connectionId, shopifyOrderId, shopifyLineItemId).
model ShopifyOrderLineSaleFact {
  id                  String                        @id @default(cuid())
  shopifyConnectionId String                        @map("shopify_connection_id")
  memberId            String                        @map("member_id")
  shopifyOrderId      String                        @map("shopify_order_id")
  shopifyLineItemId   String                        @map("shopify_line_item_id")
  shopifyVariantId    String?                       @map("shopify_variant_id")
  storeVariantId      String?                       @map("store_variant_id")
  storeItemId         String?                       @map("store_item_id")
  /// Quantity sold at the verified orders/paid event (not later refund-adjusted).
  paidQuantity        Int                           @map("paid_quantity")
  /// Quantity successfully applied to Foundation inventory (0 until applied / for failed).
  appliedQuantity     Int                           @default(0) @map("applied_quantity")
  applyState          ShopifyOrderLineSaleApplyState @default(PENDING) @map("apply_state")
  inventoryEventId    String?                       @map("inventory_event_id")
  evidenceId          String                        @map("evidence_id")
  lastErrorCode       String?                       @map("last_error_code")
  lastErrorMessage    String?                       @map("last_error_message") @db.Text
  appliedAt           DateTime?                     @map("applied_at")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")

  connection ShopifyConnection      @relation(fields: [shopifyConnectionId, memberId], references: [id, memberId], onDelete: Restrict)
  member     Member                 @relation(fields: [memberId], references: [id], onDelete: Restrict)
  evidence   ShopifyProviderEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([shopifyConnectionId, shopifyOrderId, shopifyLineItemId])
  @@index([shopifyConnectionId, applyState])
  @@index([evidenceId])
  @@index([storeVariantId])
  @@map("shopify_order_line_sale_fact")
}

/// Shopify-scoped durable sync job. At-least-once; not exactly-once.
model ShopifySyncJob {
  id                  String             @id @default(cuid())
  shopifyConnectionId String             @map("shopify_connection_id")
  kind                ShopifySyncJobKind
  dedupeKey           String             @unique @map("dedupe_key")
  evidenceId          String?            @unique @map("evidence_id")
  payload             Json?
  payloadHash         String?            @map("payload_hash") @db.VarChar(64)
  state               ShopifySyncJobState
  attemptCount        Int                @default(0) @map("attempt_count")
  maxAttempts         Int                @default(8) @map("max_attempts")
  nextAttemptAt       DateTime           @map("next_attempt_at")
  leaseOwner          String?            @map("lease_owner")
  leaseToken          String?            @map("lease_token")
  leaseExpiresAt      DateTime?          @map("lease_expires_at")
  lastErrorClass      String?            @map("last_error_class")
  lastErrorCode       String?            @map("last_error_code")
  lastErrorMessage    String?            @map("last_error_message") @db.Text
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  completedAt         DateTime?          @map("completed_at")

  connection ShopifyConnection       @relation(fields: [shopifyConnectionId], references: [id], onDelete: Restrict)
  evidence   ShopifyProviderEvidence? @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([state, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([shopifyConnectionId, state])
  @@map("shopify_sync_job")
}

