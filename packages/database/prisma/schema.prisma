// System-flagged content (moderation triggers: slurs, prohibited categories, profanity)
model FlaggedContent {
  id          String   @id @default(cuid())
  contentType String   @map("content_type") // post | message | business | event | store_item
  contentId   String?  @map("content_id")   // null if creation was blocked
