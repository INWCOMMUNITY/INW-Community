// Northwest Community - Prisma schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String   @map("password_hash")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  profilePhotoUrl   String?  @map("profile_photo_url")
  coverPhotoUrl     String?  @map("cover_photo_url")
  bio               String?
  city              String?
  couponsRedeemed       Int      @default(0) @map("coupons_redeemed")
  stripeConnectAccountId String? @map("stripe_connect_account_id") // For sellers
  stripeCustomerId      String? @map("stripe_customer_id") // For fallback payments (labels, etc.)
  shippoApiKeyEncrypted String? @map("shippo_api_key_encrypted") // Seller's Shippo API key, encrypted at rest; labels charged to seller's Shippo account
  shippoOAuthTokenEncrypted String? @map("shippo_oauth_token_encrypted") // Seller's Shippo OAuth Bearer token (from Connect with Shippo), encrypted at rest
  packingSlipNote       String? @map("packing_slip_note") @db.Text
  phone                String?
  deliveryAddress      Json?   @map("delivery_address") // private: { street, city, state, zip }
  sellerLocalDeliveryPolicy String? @map("seller_local_delivery_policy") @db.Text
  sellerPickupPolicy         String? @map("seller_pickup_policy") @db.Text
  sellerShippingPolicy String? @map("seller_shipping_policy") @db.Text
  sellerReturnPolicy String? @map("seller_return_policy") @db.Text
  /// When false, buyers cannot request a return after shipment.
  acceptReturns Boolean @default(true) @map("accept_returns")
  /// Days after delivery/pickup that a buyer may request a return.
  acceptReturnsDays Int @default(30) @map("accept_returns_days")
  /// When true, Shippo return-label cost is deducted from the buyer's refund.
  chargeReturnShipping Boolean @default(false) @map("charge_return_shipping")
  offerShipping              Boolean @default(true) @map("offer_shipping")
  /// Default new INW listings to free shipping (shippingCostCents = 0). Does not change eBay/Etsy rates.
  offerFreeShippingOnInw     Boolean @default(false) @map("offer_free_shipping_on_inw")
  offerLocalDelivery         Boolean @default(true) @map("offer_local_delivery")
  offerLocalPickup           Boolean @default(true) @map("offer_local_pickup")
  // Default for new resale listings; per-listing StoreItem.acceptOffers can override.
  acceptOffersOnResale       Boolean  @default(true) @map("accept_offers_on_resale")
  // Whether buyers can message seller about listings; must be set before first listing.
  acceptMessagesForListings  Boolean  @default(true) @map("accept_messages_for_listings")
  status            String   @default("active") // active | suspended | closed
  /// Set when the account is permanently closed (not reversible moderation).
  closedAt          DateTime? @map("closed_at")
  /// Incremented on closure so previously issued JWTs/Bearer tokens fail.
  authEpoch         Int      @default(0) @map("auth_epoch")
  privacyLevel      String   @default("public") @map("privacy_level") // public | friends_only | completely_private
  signupIntent      String?  @map("signup_intent") // resident | business | seller
  lastLogin         DateTime? @map("last_login") // For 30-day sliding session (mobile)
  /// Set when the member completes email verification (new signups enter a 6-digit code from email first).
  emailVerifiedAt   DateTime? @map("email_verified_at")
  emailVerificationTokenHash  String? @map("email_verification_token_hash")
  /// SHA-256 hex of server-peppered email + 6-digit code (new signups); link tokens use `emailVerificationTokenHash` for legacy rows only.
  emailVerificationCodeHash   String? @map("email_verification_code_hash")
  emailVerificationExpiresAt  DateTime? @map("email_verification_expires_at")
  passwordResetTokenHash  String? @map("password_reset_token_hash")
  passwordResetExpiresAt  DateTime? @map("password_reset_expires_at")
  /// Set when the member successfully completes the forgot-password flow; limits how often a new reset email is sent.
  passwordResetCompletedAt  DateTime? @map("password_reset_completed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions    Subscription[]
  businesses       Business[]
  events           Event[]
  savedItems       SavedItem[]
  storeItemsSold   StoreItem[]
  storeOrdersAsBuyer StoreOrder[] @relation("BuyerOrders")
  storeOrdersAsSeller StoreOrder[] @relation("SellerOrders")
  blocksGiven          MemberBlock[] @relation("blocksGiven")
  blocksReceived   MemberBlock[] @relation("blocksReceived")
  sellerBalance    SellerBalance?
  sellerBalanceTransactions SellerBalanceTransaction[]
  cartItems        CartItem[]
  couponRedemptions CouponRedeem[]
  blogs            Blog[]
  blogComments     BlogComment[]
  friendRequestsSent FriendRequest[] @relation("FriendRequestRequester")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestAddressee")
  following        Follow[] @relation("FollowFollower")
  followers        Follow[] @relation("FollowFollowing")
  followBusinesses FollowBusiness[]
  groupsCreated    Group[] @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupAdminInvites GroupMember[] @relation("GroupAdminInvites")
  groupAdminInvitesSent GroupAdminInvite[] @relation("GroupAdminInviter")
  groupAdminInvitesReceived GroupAdminInvite[] @relation("GroupAdminInvitee")
  eventInvitesSent EventInvite[] @relation("EventInviter")
  eventInvitesReceived EventInvite[] @relation("EventInvitee")
  groupPosts       GroupPost[]
  groupPostComments GroupPostComment[]
  groupPostLikes   GroupPostLike[]
  posts            Post[]
  postComments      PostComment[]
  postCommentLikes  PostCommentLike[]
  postLikes         PostLike[]
  followTags       FollowTag[]
  sellerTimeAway   SellerTimeAway?
  resaleOffersAsBuyer ResaleOffer[]
  resaleConversationsAsBuyer ResaleConversation[] @relation("ResaleConversationBuyer")
  resaleConversationsAsSeller ResaleConversation[] @relation("ResaleConversationSeller")
  resaleMessagesSent ResaleMessage[]
  directConversationsAsA DirectConversation[] @relation("DirectConversationMemberA")
  directConversationsAsB DirectConversation[] @relation("DirectConversationMemberB")
  directMessagesSent DirectMessage[]
  directMessageLikes    DirectMessageLike[]
  directMessageReactions DirectMessageReaction[]
  groupConversationMemberships GroupConversationMember[]
  groupConversationsCreated GroupConversation[]
  groupConversationMessagesSent GroupConversationMessage[]
  groupConversationMessageReactions GroupConversationMessageReaction[]
  nwcRequests NwcRequest[]
  referralLinks ReferralLink[]
  referralSignupsAsReferrer ReferralSignup[] @relation("ReferralSignupReferrer")
  referralSignupsAsNewMember ReferralSignup[] @relation("ReferralSignupNewMember")
  appShares MemberAppShare[]
  contentShareEvents ContentShareEvent[]
  memberListingViews MemberListingView[]
  collections Collection[]
  listingFeedCollections ListingFeedCollection[]
  priceDropAlerts PriceDropAlert[]
  reports                  Report[]
  pushTokens               MemberPushToken[]
  notificationPreferences MemberNotificationPreferences?
  webviewBridgeTokens      WebviewBridgeToken[]
  planSwitchLogs           PlanSwitchLog[]
  groupCreationRequests    GroupCreationRequest[] @relation("GroupCreationRequester")
  groupMemberBansSubject   GroupMemberBan[]       @relation("GroupMemberBanSubject")
  groupMemberBansIssued    GroupMemberBan[]       @relation("GroupMemberBanIssuer")
  groupDeletionRequests    GroupDeletionRequest[] @relation("GroupDeletionRequester")
  listingTemplates         ListingTemplate[]
  shippingOptions          ShippingOption[]
  sellerAnalyticsEvents    SellerAnalyticsEvent[]
  sellerActivityLogs       SellerActivityLog[]
  bulkEditSnapshots        BulkEditSnapshot[]
  pollVotes                PostPollVote[]
  storeVariants            StoreVariant[]
  inventoryStates          InventoryState[]
  inventoryEvents          InventoryEvent[]
  variantBackfillMaps      VariantBackfillMap[]
  checkoutAttempts         CheckoutAttempt[]
  inventoryReservations    InventoryReservation[]
  refundOperations         RefundOperation[]
  transferOperations       TransferOperation[]
  sellerReturnEntitlementOperations SellerReturnEntitlementOperation[]
  shopifyConnections   ShopifyConnection[]
  shopifyOAuthStates   ShopifyOAuthState[]
  shopifyListingLinks  ShopifyListingLink[]
  shopifyVariantMaps   ShopifyVariantMap[]
  shopifyOrderLineSaleFacts ShopifyOrderLineSaleFact[]
}

model WebviewBridgeToken {
  id         String    @id @default(cuid())
  token      String    @unique
  memberId   String    @map("member_id")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresAt])
  @@map("webview_bridge_token")
}

model MemberPushToken {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  token     String   @unique // Expo push token (ExponentPushToken[...])
  deviceId  String?  @map("device_id") // Optional device identifier for upsert
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_push_token")
}

/// Per-member toggles for push notification categories (mobile).
model MemberNotificationPreferences {
  memberId           String   @id @map("member_id")
  notifyBadges       Boolean  @default(true) @map("notify_badges")
  notifyMessages     Boolean  @default(true) @map("notify_messages")
  notifyComments     Boolean  @default(true) @map("notify_comments")
  notifyEvents       Boolean  @default(true) @map("notify_events")
  notifyGroupAdmin   Boolean  @default(true) @map("notify_group_admin")
  notifyCommerce     Boolean  @default(true) @map("notify_commerce")
  notifySocial       Boolean  @default(true) @map("notify_social")
  notifySellerOps    Boolean  @default(true) @map("notify_seller_ops") // Low stock alerts, sync issues, etc.
  updatedAt          DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_notification_preferences")
}

model SellerTimeAway {
  id        String   @id @default(cuid())
  memberId  String   @unique @map("member_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("seller_time_away")
}

model SellerBalance {
  id               String   @id @default(cuid())
  memberId         String   @unique @map("member_id")
  balanceCents     Int      @default(0) @map("balance_cents")
  totalEarnedCents Int      @default(0) @map("total_earned_cents")
  totalPaidOutCents Int     @default(0) @map("total_paid_out_cents")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
}

model SellerBalanceTransaction {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id")
  type        String   // sale | label | return | payout | fee
  amountCents Int      @map("amount_cents") // positive = credit, negative = debit
  orderId     String?  @map("order_id")
  shipmentId  String?  @map("shipment_id")
  stripeTransferId String? @map("stripe_transfer_id")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
}

model CartItem {
  id                   String   @id @default(cuid())
  memberId             String   @map("member_id")
  storeItemId          String   @map("store_item_id")
  quantity             Int      @default(1)
  variant              Json?    // selected variant if applicable
  fulfillmentType      String?  @map("fulfillment_type") // ship | local_delivery | pickup
  localDeliveryDetails Json?    @map("local_delivery_details")
  pickupDetails        Json?    @map("pickup_details") // { firstName, lastName, phone, note?, termsAcceptedAt }
  priceOverrideCents   Int?     @map("price_override_cents") // locked offer price
  resaleOfferId        String?  @unique @map("resale_offer_id")
  createdAt            DateTime @default(now()) @map("created_at")

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeItem StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  resaleOffer ResaleOffer? @relation(fields: [resaleOfferId], references: [id], onDelete: SetNull)
  /// Nullable until cart writer cutover. Composite (variantId, storeItemId) is enforced in M1 SQL.
  variantId String? @map("variant_id")
  storeVariant StoreVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([variantId])
}

model Subscription {
  id                   String   @id @default(cuid())
  memberId             String   @map("member_id")
  plan                 Plan     // subscribe | sponsor | seller
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  stripeCustomerId     String?  @map("stripe_customer_id")
  status               String   // active | canceled | past_due | trialing
  currentPeriodEnd     DateTime? @map("current_period_end")
  trialEnd             DateTime? @map("trial_end")
  renewalReminderPeriodEnd DateTime? @map("renewal_reminder_period_end")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// Audit + rate limit for change-plan API (max 2 per rolling 30 days unless admin).
model PlanSwitchLog {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  fromPlan  Plan     @map("from_plan")
  toPlan    Plan     @map("to_plan")
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("plan_switch_log")
}

enum Plan {
  subscribe
  sponsor
  seller
}

model Business {
  id               String   @id @default(cuid())
  memberId         String   @map("member_id")
  name             String
  shortDescription String?  @map("short_description")
  fullDescription  String?  @map("full_description")
  website          String?
  phone            String?
  email            String?
  logoUrl          String?  @map("logo_url")
  address          String?
  city             String?
  categories              String[] @default([]) // up to 2 primary categories (directory + badge matching)
  subcategoriesByPrimary  Json     @default("{}") @map("subcategories_by_primary") // { "Primary": ["Sub A", "Sub B"], ... }
  hoursOfOperation Json?   @map("hours_of_operation") // { sunday: "CLOSED", monday: "9:30-5:00", ... }
  slug             String   @unique
  photos           String[] // JSON array of URLs
  coverPhotoUrl    String?  @map("cover_photo_url") // Seller storefront backdrop (Facebook-style cover)
  facebookUrl      String?  @map("facebook_url")
  instagramUrl     String?  @map("instagram_url")
  tiktokUrl        String?  @map("tiktok_url")
  nameApprovalStatus String @default("approved") @map("name_approval_status") // approved | pending | rejected (profanity in name)
  adminGrantedAt     DateTime? @map("admin_granted_at") // When set, this business was assigned by admin; owner gets free Business Hub access without a subscription
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  followBusinesses FollowBusiness[]
  coupons  Coupon[]
  events   Event[]
  storeItems StoreItem[]

  @@index([memberId])
}

model Coupon {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  name           String
  discount       String
  code           String
  imageUrl       String?   @map("image_url")
  secretKey      String?   @map("secret_key")
  maxMonthlyUses Int       @default(1) @map("max_monthly_uses")
  /// When set, coupon is hidden from the public coupon book and detail after this instant (owners still manage it).
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions CouponRedeem[]
}

model CouponRedeem {
  id             String   @id @default(cuid())
  couponId       String   @map("coupon_id")
  memberId       String?  @map("member_id")
  createdAt      DateTime @default(now()) @map("created_at")

  coupon Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([memberId])
}

model Event {
  id           String       @id @default(cuid())
  memberId     String?      @map("member_id")
  businessId   String?      @map("business_id")
  calendarType CalendarType @map("calendar_type")
  title        String
  date         DateTime     @db.Date
  time         String?
  endTime      String?      @map("end_time")
  location     String?
  city         String?
  description  String?
  slug         String       @unique
  photos       String[]
  status       String       @default("approved") // pending | approved
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  eventInvites EventInvite[]

  @@index([date])
  @@index([status, date])
}

model EventInvite {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  inviterId String   @map("inviter_id")
  inviteeId String   @map("invitee_id")
  status    String   @default("pending") // pending | accepted | declined
  createdAt DateTime @default(now()) @map("created_at")

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviter Member @relation("EventInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee Member @relation("EventInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([eventId, inviteeId])
  @@index([inviteeId])
}

enum CalendarType {
  fun_events
  local_art_music
  non_profit
  business_promotional
  marketing
  real_estate
}

model SavedItem {
  id          String       @id @default(cuid())
  memberId    String       @map("member_id")
  type        SavedItemType
  referenceId String       @map("reference_id") // event id, business id, or future store_item id
  createdAt   DateTime    @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type, referenceId])
  @@index([memberId])
}

enum SavedItemType {
  event
  business
  coupon
  store_item
  blog
  post
}

model Collection {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id")
  name        String
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  CollectionItem[]

  @@index([memberId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  storeItemId  String   @map("store_item_id")
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  storeItem  StoreItem  @relation(fields: [storeItemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, storeItemId])
  @@index([storeItemId])
}

/// Seller import/list batch shared on the community feed (4+ listings). Distinct from buyer wishlist Collection.
model ListingFeedCollection {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  member Member                      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  ListingFeedCollectionItem[]
  posts  Post[]

  @@index([memberId])
  @@map("listing_feed_collection")
}

model ListingFeedCollectionItem {
  id           String @id @default(cuid())
  collectionId String @map("collection_id")
  storeItemId  String @map("store_item_id")
  sortOrder    Int    @default(0) @map("sort_order")

  collection ListingFeedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  storeItem  StoreItem             @relation(fields: [storeItemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, storeItemId])
  @@index([storeItemId])
  @@map("listing_feed_collection_item")
}

model PriceDropAlert {
  id            String    @id @default(cuid())
  memberId      String    @map("member_id")
  storeItemId   String    @map("store_item_id")
  targetPrice   Int?      @map("target_price_cents")
  originalPrice Int       @map("original_price_cents")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  triggeredAt   DateTime? @map("triggered_at")

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeItem StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)

  @@unique([memberId, storeItemId])
  @@index([storeItemId, active])
  @@map("price_drop_alert")
}

model StoreCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  bannerUrl   String? @map("banner_url")
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("store_category")
}

// Blog system - admin-approved posts
model BlogCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  blogs Blog[]
}

model Blog {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id")
  categoryId  String   @map("category_id")
  title       String
  body        String   @db.Text
  photos      String[]
  slug        String   @unique
  status      String   @default("pending") // pending | approved
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  comments BlogComment[]
  blogTags BlogTag[]

  @@index([memberId])
  @@index([categoryId])
  @@index([status])
}

model BlogComment {
  id        String   @id @default(cuid())
  blogId    String   @map("blog_id")
  memberId  String   @map("member_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

// Mutual friends - both must accept
model FriendRequest {
  id          String   @id @default(cuid())
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now()) @map("created_at")

  requester Member @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Member @relation("FriendRequestAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// Follow blog authors for feed
model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  Member @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following Member @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Follow seller storefronts (businesses)
model FollowBusiness {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id")
  businessId  String   @map("business_id")
  createdAt   DateTime @default(now()) @map("created_at")

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([memberId, businessId])
  @@index([businessId])
  @@map("follow_business")
}

// Community groups
model Group {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  category      String?
  coverImageUrl String?  @map("cover_image_url")
  rules         String?  @db.Text
  /// When true, members may post as a directory business (shared_business) into this group.
  allowBusinessPosts Boolean @default(false) @map("allow_business_posts")
  slug          String   @unique
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy  Member       @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members    GroupMember[]
  groupPosts GroupPost[]
  adminInvites GroupAdminInvite[]
  creationSourceRequest GroupCreationRequest?
  memberBans            GroupMemberBan[]
  deletionRequests      GroupDeletionRequest[]

  @@index([createdById])
}

/// Member-submitted request to create a community group; platform admin approves or denies.
model GroupCreationRequest {
  id                   String    @id @default(cuid())
  requesterMemberId    String    @map("requester_member_id")
  name                 String
  description          String?   @db.Text
  category             String?
  coverImageUrl        String?   @map("cover_image_url")
  rules                String?   @db.Text
  allowBusinessPosts   Boolean   @default(false) @map("allow_business_posts")
  status               String    @default("pending") // pending | approved | denied
  denialReason         String?   @map("denial_reason") @db.Text
  reviewedAt           DateTime? @map("reviewed_at")
  reviewedByAdminEmail String?   @map("reviewed_by_admin_email")
  resultingGroupId     String?   @unique @map("resulting_group_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  requester      Member @relation("GroupCreationRequester", fields: [requesterMemberId], references: [id], onDelete: Cascade)
  resultingGroup Group? @relation(fields: [resultingGroupId], references: [id], onDelete: SetNull)

  @@index([requesterMemberId])
  @@index([status])
  @@map("group_creation_request")
}

model GroupAdminInvite {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  inviterId   String   @map("inviter_id")
  inviteeId   String   @map("invitee_id")
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now()) @map("created_at")

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter Member @relation("GroupAdminInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee Member @relation("GroupAdminInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([groupId, inviteeId])
  @@index([inviteeId])
}

model GroupMember {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  memberId    String   @map("member_id")
  role        String   @default("member") // member | admin
  invitedById String?  @map("invited_by_id") // admin who invited this member as admin
  joinedAt    DateTime @default(now()) @map("joined_at")

  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invitedBy Member? @relation("GroupAdminInvites", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([groupId, memberId])
  @@index([memberId])
}

/// Admin removed this member; they cannot rejoin or see the group in listings.
model GroupMemberBan {
  id               String   @id @default(cuid())
  groupId          String   @map("group_id")
  memberId         String   @map("member_id")
  bannedByMemberId String   @map("banned_by_member_id")
  createdAt        DateTime @default(now()) @map("created_at")

  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member @relation("GroupMemberBanSubject", fields: [memberId], references: [id], onDelete: Cascade)
  bannedBy Member @relation("GroupMemberBanIssuer", fields: [bannedByMemberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@index([memberId])
  @@map("group_member_ban")
}

/// Group creator requests deletion; site admin must approve before the group is removed.
model GroupDeletionRequest {
  id                   String    @id @default(cuid())
  groupId              String    @map("group_id")
  requesterMemberId    String    @map("requester_member_id")
  status               String    @default("pending") // pending | approved | denied
  denialReason         String?   @map("denial_reason") @db.Text
  reviewedAt           DateTime? @map("reviewed_at")
  reviewedByAdminEmail String?   @map("reviewed_by_admin_email")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester Member @relation("GroupDeletionRequester", fields: [requesterMemberId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([status])
  @@map("group_deletion_request")
}

model GroupPost {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  memberId  String   @map("member_id")
  content   String   @db.Text
  photos    String[]
  videos    String[] // video URLs
  createdAt DateTime @default(now()) @map("created_at")

  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  comments GroupPostComment[]
  likes    GroupPostLike[]

  @@index([groupId])
}

model GroupPostComment {
  id        String   @id @default(cuid())
  groupPostId String @map("group_post_id")
  memberId  String   @map("member_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  groupPost GroupPost @relation(fields: [groupPostId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupPostId])
}

model GroupPostLike {
  id          String   @id @default(cuid())
  groupPostId String   @map("group_post_id")
  memberId    String   @map("member_id")
  createdAt   DateTime @default(now()) @map("created_at")

  groupPost GroupPost @relation(fields: [groupPostId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupPostId, memberId])
  @@index([memberId])
}

// Public tags - followable, used on posts and blogs
model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  postTags  PostTag[]
  blogTags  BlogTag[]
  followTag FollowTag[]

  @@index([slug])
}

model PostTag {
  id      String @id @default(cuid())
  postId  String @map("post_id")
  tagId   String @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
}

model BlogTag {
  id      String @id @default(cuid())
  blogId  String @map("blog_id")
  tagId   String @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([blogId, tagId])
  @@index([tagId])
}

model FollowTag {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memberId, tagId])
  @@index([tagId])
}

// Unified feed post - personal, group, shared_blog, shared_post, shared_business, shared_coupon, shared_store_item, shared_listing_collection
model Post {
  id              String   @id @default(cuid())
  type            String   // personal | group | shared_blog | shared_post | shared_business | shared_coupon | shared_store_item | shared_event | shared_listing_collection
  authorId        String   @map("author_id")
  content         String?  @db.Text
  photos          String[]
  videos          String[] // video URLs (YouTube, Vimeo, or uploaded)
  links           Json?    // [{url, title}]
  sourceBlogId    String?  @map("source_blog_id")
  sourcePostId    String?  @map("source_post_id")
  sourceBusinessId String? @map("source_business_id")
  sourceCouponId  String?  @map("source_coupon_id")
  sourceStoreItemId String? @map("source_store_item_id")
  sourceEventId   String?  @map("source_event_id")
  sourceListingCollectionId String? @map("source_listing_collection_id")
  groupId             String?  @map("group_id")
  taggedMemberIds     String[] @default([]) @map("tagged_member_ids")
  /// Saved-directory businesses the author tagged (distinct from shared_business / posting-as).
  taggedBusinessIds   String[] @default([]) @map("tagged_business_ids")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  author       Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sourceListingCollection ListingFeedCollection? @relation(fields: [sourceListingCollectionId], references: [id], onDelete: Cascade)
  comments     PostComment[]
  likes        PostLike[]
  postTags     PostTag[]
  poll         PostPoll?

  @@index([authorId])
  @@index([groupId])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
  @@index([sourcePostId])
  @@index([sourceBlogId])
  @@index([sourceBusinessId])
  @@index([sourceCouponId])
  @@index([sourceStoreItemId])
  @@index([sourceEventId])
  @@index([sourceListingCollectionId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  parentId  String?  @map("parent_id")
  memberId  String   @map("member_id")
  content   String   @db.Text
  photos    String[] @default([]) // image/GIF URLs
  createdAt DateTime @default(now()) @map("created_at")

  post     Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent   PostComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[]  @relation("CommentReplies")
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  likes    PostCommentLike[]

  @@index([postId])
  @@index([parentId])
}

model PostCommentLike {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  memberId  String   @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  member  Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
  @@index([memberId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  memberId  String   @map("member_id")
  reaction  String   @default("leaf") // leaf | love | laugh | support | insightful
  createdAt DateTime @default(now()) @map("created_at")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@index([memberId])
}

model SiteContent {
  id        String   @id @default(cuid())
  pageId    String   @unique @map("page_id") // e.g. "home", "about", "support-local"
  structure Json     // { sections: [{ columns: [{ blocks: [...] }] }] }
  updatedAt DateTime @updatedAt @map("updated_at")
}

model DesignTokens {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "primaryColor", "headingFont"
  value     String   // JSON or string value
  updatedAt DateTime @updatedAt @map("updated_at")
}

model AdminSession {
  id        String   @id @default(cuid())
  code      String   @unique // NWC36481
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
}

model Policy {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "terms", "privacy", "refunds"
  title     String   // e.g. "Terms of Service"
  content   String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
}


// Storefront - products listed by sellers
model StoreItem {
  id                  String   @id @default(cuid())
  /// Hub join-key SKU (alphanumeric). INW mints `nwc…` when blank. Never StoreItem.id.
  sku                 String?  @map("sku")
  /// UPC, EAN, GTIN, or ISBN barcode. Mapped to Shopify variant barcode.
  barcode             String?  @map("barcode")
  memberId            String   @map("member_id")
  businessId          String?  @map("business_id")
  title               String
  description         String?  @db.Text
  photos              String[]
  category            String?
  /// Optional second browse tag (distinct from `category`; max two top-level categories per listing).
  secondaryCategory   String?  @map("secondary_category")
  subcategory         String?  @map("subcategory")
  priceCents          Int      @map("price_cents")
  /// "Was" / strikethrough price in cents; shown as compare_at_price on Shopify / sale pricing.
  compareAtPriceCents Int?     @map("compare_at_price_cents")
  variants            Json?    // matrix { axes, skus } or legacy [{ name, options }]
  /// Item specifics / product aspects: [{ name: "Brand", value: "Nike" }, ...].
  /// Maps to eBay product.aspects; ignored by Etsy/Wix/Shopify adapters.
  aspects             Json?    @map("aspects")
  /// Comma-separated or array of searchable tags. Maps to Shopify tags, used for smart collections.
  tags                String[] @default([])
  /// Manufacturer or brand name. Maps to Shopify vendor.
  vendor              String?  @map("vendor")
  quantity            Int      @default(0)
  /// tracked | made_to_order — made_to_order does not require or decrement stock.
  inventoryTracking   String   @default("tracked") @map("inventory_tracking")
  status              String   @default("active") // active | sold_out | inactive
  shippingCostCents   Int?     @map("shipping_cost_cents")
  shippingOptionId    String?  @map("shipping_option_id")
  shippingPolicy      String?  @map("shipping_policy") @db.Text
  localDeliveryAvailable Boolean @default(false) @map("local_delivery_available")
  localDeliveryFeeCents Int?     @map("local_delivery_fee_cents")
  inStorePickupAvailable Boolean @default(false) @map("in_store_pickup_available")
  shippingDisabled     Boolean  @default(false) @map("shipping_disabled")
  localDeliveryTerms   String?  @map("local_delivery_terms") @db.Text
  pickupTerms          String?  @map("pickup_terms") @db.Text
  stripePriceId       String?  @map("stripe_price_id")
  slug                String   @unique
  condition           String   @default("new") @map("condition") // "new" | "used"
  listingType         String   @default("new") @map("listing_type") // deprecated: always "new" (single store)
  acceptOffers         Boolean  @default(true) @map("accept_offers") // used items: allow make-offer
  minOfferCents        Int?     @map("min_offer_cents") // used items: auto-decline offers below this
  lowStockThreshold    Int?     @map("low_stock_threshold") // Alert when quantity falls to or below this value
  featured             Boolean  @default(false) @map("featured") // Admin-curated featured listings
  /// Set when the listing is ended (status inactive). Ended listings are retained for commerce/history. Cleared on relist.
  endedAt             DateTime? @map("ended_at")
  /// Semantic listing-content version. Not a timestamp. Starts at 1.
  contentVersion      Int      @default(1) @map("content_version")
  /// Semantic listing-lifecycle version (active / ended). Not a timestamp. Starts at 1.
  lifecycleVersion    Int      @default(1) @map("lifecycle_version")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  shippingOption ShippingOption? @relation(fields: [shippingOptionId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  cartItems CartItem[]
  resaleOffers ResaleOffer[]
  resaleConversations ResaleConversation[]
  sellerAnalyticsEvents SellerAnalyticsEvent[]
  memberViews MemberListingView[]
  collectionItems CollectionItem[]
  listingFeedCollectionItems ListingFeedCollectionItem[]
  priceDropAlerts PriceDropAlert[]
  storeVariants StoreVariant[]
  inventoryStates InventoryState[]
  inventoryEvents InventoryEvent[]
  variantBackfillMaps VariantBackfillMap[]
  inventoryReservations InventoryReservation[]
  shopifyListingLinks ShopifyListingLink[]

  @@unique([id, memberId])
  @@index([status, endedAt])
  @@index([status, createdAt])
  @@index([memberId, status])
  @@index([category, status])
}

enum StoreVariantStatus {
  ACTIVE
  RETIRED

  @@map("store_variant_status")
}

enum InventoryMode {
  TRACKED_FINITE
  MADE_TO_ORDER

  @@map("inventory_mode")
}

enum InventoryEventType {
  SALE
  SET
  ADJUSTMENT
  RESERVATION_HOLD
  RESERVATION_RELEASE
  RESERVATION_CONVERT
  RESERVATION_INVALIDATE
  UNDO_CONSUMPTION
  PHYSICAL_RECEIPT
  OPENING_BALANCE
  CORRECTION

  @@map("inventory_event_type")
}

enum CheckoutAttemptState {
  CREATED
  SESSION_OPEN
  SESSION_FAILED
  SESSION_UNKNOWN
  PAID
  CLOSED

  @@map("checkout_attempt_state")
}

/// Stripe payment truth for a CheckoutAttempt. Not commerce finalization.
enum CheckoutPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED

  @@map("checkout_payment_status")
}

/// Local commerce finalization, independent of StoreOrder.status and Stripe paymentStatus.
/// Default PENDING on existing rows is compatibility only — not proof the order used reservations.
enum CommerceStatus {
  PENDING
  FINALIZED
  UNFULFILLABLE
  REFUND_REQUIRED

  @@map("commerce_status")
}

enum StripeEvidenceProcessState {
  RECEIVED
  PROCESSED
  IGNORED
  ERROR

  @@map("stripe_evidence_process_state")
}

enum RefundKind {
  FULL
  PARTIAL
  COURTESY
  RETURN

  @@map("refund_kind")
}

/// Shared refund/transfer provider-operation state. PROCESSING = request in flight; UNCERTAIN = local ack lost.
enum FinancialOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNCERTAIN

  @@map("financial_operation_status")
}

/// Durable sellable child of StoreItem. Identity is `id`; SKU/options are mutable attributes.
model StoreVariant {
  id                  String             @id @default(cuid())
  memberId            String             @map("member_id")
  storeItemId         String             @map("store_item_id")
  status              StoreVariantStatus @default(ACTIVE)
  isDefault           Boolean            @default(false) @map("is_default")
  sku                 String?
  barcode             String?
  /// Option labels as a JSON map, e.g. {"Size":"M","Color":"Red"}. Not identity.
  options             Json               @default("{}")
  priceCents          Int                @map("price_cents")
  compareAtPriceCents Int?               @map("compare_at_price_cents")
  photos              String[]           @default([])
  offerVersion        Int                @default(1) @map("offer_version")
  sortOrder           Int?               @map("sort_order")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  retiredAt           DateTime?          @map("retired_at")

  member          Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  storeItem       StoreItem            @relation(fields: [storeItemId, memberId], references: [id, memberId], onDelete: Restrict)
  inventoryState  InventoryState?
  inventoryEvents InventoryEvent[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  backfillMaps    VariantBackfillMap[]
  reservations    InventoryReservation[]
  shopifyVariantMaps ShopifyVariantMap[]

  @@unique([id, memberId])
  @@unique([id, storeItemId])
  @@unique([id, storeItemId, memberId])
  @@index([storeItemId, status])
  @@index([memberId, status])
  @@map("store_variant")
}

/// 1:1 current finite inventory for a Variant. `available` is derived (onHand - reserved), not stored.
model InventoryState {
  variantId            String        @id @map("variant_id")
  memberId             String        @map("member_id")
  storeItemId          String        @map("store_item_id")
  mode                 InventoryMode
  onHand               Int?          @map("on_hand")
  reserved             Int?
  availabilityVersion  Int           @default(1) @map("availability_version")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  member    Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  storeItem StoreItem    @relation(fields: [storeItemId, memberId], references: [id, memberId], onDelete: Restrict)
  variant   StoreVariant @relation(fields: [variantId, storeItemId, memberId], references: [id, storeItemId, memberId], onDelete: Cascade)

  @@unique([variantId, memberId])
  @@unique([variantId, storeItemId, memberId])
  @@index([storeItemId])
  @@map("inventory_state")
}

/// Append-only causal inventory history. Rejected stale SET commands are not persisted.
model InventoryEvent {
  id                          String             @id @default(cuid())
  memberId                    String             @map("member_id")
  variantId                   String             @map("variant_id")
  storeItemId                 String             @map("store_item_id")
  eventType                   InventoryEventType @map("event_type")
  /// e.g. INW_ORDER | MARKETPLACE_ORDER | SELLER | ADMIN | SYSTEM_MIGRATION | RETURN | CANCEL | REFUND | EXPIRE | CHECKOUT
  cause                       String
  sourceSystem                String             @map("source_system")
  /// Canonical empty string when unused so unique-index NULL semantics cannot allow duplicates.
  sourceScope                 String             @default("") @map("source_scope")
  sourceFactId                String             @map("source_fact_id")
  requestedQty                Int                @default(0) @map("requested_qty")
  appliedOnHandQty            Int                @default(0) @map("applied_on_hand_qty")
  appliedReservedQty          Int                @default(0) @map("applied_reserved_qty")
  shortageQty                 Int                @default(0) @map("shortage_qty")
  displacedReservationQty     Int                @default(0) @map("displaced_reservation_qty")
  onHandBefore                Int?               @map("on_hand_before")
  onHandAfter                 Int?               @map("on_hand_after")
  reservedBefore              Int?               @map("reserved_before")
  reservedAfter               Int?               @map("reserved_after")
  commandId                   String?            @map("command_id")
  expectedAvailabilityVersion Int?               @map("expected_availability_version")
  targetOnHand                Int?               @map("target_on_hand")
  originalSaleEventId         String?            @map("original_sale_event_id")
  orderItemId                 String?            @map("order_item_id")
  reservationId               String?            @map("reservation_id")
  metadata                    Json?
  occurredAt                  DateTime           @default(now()) @map("occurred_at")
  createdAt                   DateTime           @default(now()) @map("created_at")

  member            Member          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  storeItem         StoreItem       @relation(fields: [storeItemId, memberId], references: [id, memberId], onDelete: Restrict)
  variant           StoreVariant    @relation(fields: [variantId, storeItemId, memberId], references: [id, storeItemId, memberId], onDelete: Restrict)
  originalSaleEvent InventoryEvent? @relation("InventoryEventUndoOfSale", fields: [originalSaleEventId], references: [id], onDelete: Restrict)
  undoEvents        InventoryEvent[] @relation("InventoryEventUndoOfSale")
  orderItem         OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  reservation       InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([memberId, sourceSystem, sourceScope, eventType, sourceFactId], map: "inventory_event_causal_key")
  @@index([variantId, createdAt])
  @@index([originalSaleEventId, eventType])
  @@index([orderItemId])
  @@index([reservationId])
  @@map("inventory_event")
}

/// One durable local identity for one multi-seller checkout/payment session.
model CheckoutAttempt {
  id                      String                @id @default(cuid())
  buyerMemberId           String                @map("buyer_member_id")
  state                   CheckoutAttemptState  @default(CREATED)
  cartHash                String                @map("cart_hash")
  amountCents             Int                   @map("amount_cents")
  currency                String                @default("usd")
  stripeIdempotencyKey    String                @unique @map("stripe_idempotency_key")
  stripeCheckoutSessionId String?               @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?               @unique @map("stripe_payment_intent_id")
  paymentStatus           CheckoutPaymentStatus @default(UNPAID) @map("payment_status")
  expiresAt               DateTime?             @map("expires_at")
  reconciledAt            DateTime?             @map("reconciled_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  buyer        Member                  @relation(fields: [buyerMemberId], references: [id], onDelete: Restrict)
  storeOrders  StoreOrder[]
  reservations InventoryReservation[]
  stripeEvents StripeEventEvidence[]
  refundOperations RefundOperation[]

  @@index([buyerMemberId, createdAt])
  @@index([state])
  @@map("checkout_attempt")
}

/// Hold/convert/release counters for one OrderItem. Counters are the authority; no writable status.
/// `memberId` is the seller inventory tenant (Variant owner), not the CheckoutAttempt buyer.
model InventoryReservation {
  id                String   @id @default(cuid())
  memberId          String   @map("member_id")
  checkoutAttemptId String   @map("checkout_attempt_id")
  storeOrderId      String   @map("store_order_id")
  orderItemId       String   @unique @map("order_item_id")
  variantId         String   @map("variant_id")
  storeItemId       String   @map("store_item_id")
  originalQty       Int      @map("original_qty")
  activeQty         Int      @map("active_qty")
  convertedQty      Int      @map("converted_qty")
  releasedQty       Int      @map("released_qty")
  invalidatedQty    Int      @map("invalidated_qty")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  member          Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  checkoutAttempt CheckoutAttempt  @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict)
  storeOrder      StoreOrder       @relation(fields: [storeOrderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  storeItem       StoreItem        @relation(fields: [storeItemId, memberId], references: [id, memberId], onDelete: Restrict)
  variant         StoreVariant     @relation(fields: [variantId, storeItemId, memberId], references: [id, storeItemId, memberId], onDelete: Restrict)
  inventoryEvents InventoryEvent[]

  @@map("inventory_reservation")
}

/// Durable Stripe webhook/event evidence. Not a SALE/inventory event. Duplicate deliveries lookup by stripeEventId.
model StripeEventEvidence {
  id                String                     @id @default(cuid())
  stripeEventId     String                     @unique @map("stripe_event_id")
  eventType         String                     @map("event_type")
  stripeCreatedAt   DateTime                   @map("stripe_created_at")
  receivedAt        DateTime                   @default(now()) @map("received_at")
  payload           Json
  payloadHash       String?                    @map("payload_hash")
  processState      StripeEvidenceProcessState @default(RECEIVED) @map("process_state")
  lastError         String?                    @map("last_error") @db.Text
  checkoutAttemptId String?                    @map("checkout_attempt_id")
  processedAt       DateTime?                  @map("processed_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  checkoutAttempt CheckoutAttempt? @relation(fields: [checkoutAttemptId], references: [id], onDelete: SetNull)

  @@index([processState, receivedAt])
  @@map("stripe_event_evidence")
}

/// Durable local refund-provider intention. restockRequested is policy only and does not mutate inventory.
/// memberId is the seller tenant, not the buyer.
model RefundOperation {
  id                      String                    @id @default(cuid())
  memberId                String                    @map("member_id")
  storeOrderId            String                    @map("store_order_id")
  orderItemId             String?                   @map("order_item_id")
  checkoutAttemptId       String?                   @map("checkout_attempt_id")
  kind                    RefundKind
  amountCents             Int                       @map("amount_cents")
  currency                String                    @default("usd")
  restockRequested        Boolean                   @default(false) @map("restock_requested")
  reason                  String?
  providerIdempotencyKey  String                    @unique @map("provider_idempotency_key")
  stripeRefundId          String?                   @unique @map("stripe_refund_id")
  status                  FinancialOperationStatus  @default(PENDING)
  retryCount              Int                       @default(0) @map("retry_count")
  lastError               String?                   @map("last_error") @db.Text
  lastAttemptAt           DateTime?                 @map("last_attempt_at")
  succeededAt             DateTime?                 @map("succeeded_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  member          Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  storeOrder      StoreOrder       @relation(fields: [storeOrderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  checkoutAttempt CheckoutAttempt? @relation(fields: [checkoutAttemptId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("refund_operation")
}

/// Durable seller Stripe Connect transfer intention. One canonical payout per StoreOrder for v1.
/// memberId is the seller tenant.
model TransferOperation {
  id                     String                   @id @default(cuid())
  memberId               String                   @map("member_id")
  storeOrderId           String                   @unique @map("store_order_id")
  providerIdempotencyKey String                   @unique @map("provider_idempotency_key")
  stripeTransferId       String?                  @unique @map("stripe_transfer_id")
  amountCents            Int                      @map("amount_cents")
  currency               String                   @default("usd")
  status                 FinancialOperationStatus @default(PENDING)
  retryCount             Int                      @default(0) @map("retry_count")
  lastError              String?                  @map("last_error") @db.Text
  lastAttemptAt          DateTime?                @map("last_attempt_at")
  succeededAt            DateTime?                @map("succeeded_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  member     Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  storeOrder StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("transfer_operation")
}

/// Post-return seller Connect entitlement when the original full sale transfer was prevented.
/// One per StoreOrder for v1. amountCents is the immutable post-return entitlement (DB CHECK > 0).
model SellerReturnEntitlementOperation {
  id                     String                   @id @default(cuid())
  memberId               String                   @map("member_id")
  storeOrderId           String                   @unique(map: "sreo_store_order_id_key") @map("store_order_id")
  storeReturnId          String                   @unique(map: "sreo_store_return_id_key") @map("store_return_id")
  providerIdempotencyKey String                   @unique(map: "sreo_provider_idempotency_key_key") @map("provider_idempotency_key")
  stripeTransferId           String?                  @unique(map: "sreo_stripe_transfer_id_key") @map("stripe_transfer_id")
  stripeDestinationAccountId String?                  @map("stripe_destination_account_id")
  stripeSourceChargeId       String?                  @map("stripe_source_charge_id")
  amountCents            Int                      @map("amount_cents")
  currency               String                   @default("usd")
  status                 FinancialOperationStatus @default(PENDING)
  retryCount             Int                      @default(0) @map("retry_count")
  lastError              String?                  @map("last_error") @db.Text
  lastAttemptAt          DateTime?                @map("last_attempt_at")
  succeededAt            DateTime?                @map("succeeded_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  member      Member      @relation(fields: [memberId], references: [id], onDelete: Restrict, map: "sreo_member_id_fkey")
  storeOrder  StoreOrder  @relation(fields: [storeOrderId], references: [id], onDelete: Restrict, map: "sreo_store_order_id_fkey")
  storeReturn StoreReturn @relation(fields: [storeReturnId], references: [id], onDelete: Restrict, map: "sreo_store_return_id_fkey")

  @@index([status, createdAt], map: "sreo_status_created_at_idx")
  @@map("seller_return_entitlement_operation")
}

/// Temporary idempotent backfill allocation: legacy snapshot fingerprint → StoreVariant.id. Not business identity.
model VariantBackfillMap {
  id                 String   @id @default(cuid())
  storeItemId        String   @map("store_item_id")
  memberId           String   @map("member_id")
  sourceFingerprint  String   @map("source_fingerprint")
  variantId          String   @unique @map("variant_id")
  createdAt          DateTime @default(now()) @map("created_at")

  member    Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  storeItem StoreItem    @relation(fields: [storeItemId, memberId], references: [id, memberId], onDelete: Restrict)
  variant   StoreVariant @relation(fields: [variantId, storeItemId, memberId], references: [id, storeItemId, memberId], onDelete: Restrict)

  @@unique([storeItemId, sourceFingerprint])
  @@map("variant_backfill_map")
}

model MemberListingView {
  id          String   @id @default(cuid())
  viewerId    String?  @map("viewer_id")
  sessionId   String?  @map("session_id")
  storeItemId String   @map("store_item_id")
  source      String   // mobile | web
  createdAt   DateTime @default(now()) @map("created_at")

  viewer    Member?    @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  storeItem StoreItem  @relation(fields: [storeItemId], references: [id], onDelete: Cascade)

  @@index([storeItemId, createdAt])
  @@index([viewerId, createdAt])
  @@map("member_listing_view")
}

/// Single-row lease so overlapping Vercel cron invocations cannot share a connection set.
model CronJobLock {
  jobName        String    @id @map("job_name")
  holderId       String    @map("holder_id")
  acquiredAt     DateTime  @map("acquired_at")
  expiresAt      DateTime  @map("expires_at")
  passStartedAt  DateTime? @map("pass_started_at")
  lastDurationMs Int?      @map("last_duration_ms")
  lastFinishedAt DateTime? @map("last_finished_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("cron_job_lock")
}

/// Singleton cutover mode for commerce-foundation inventory writer switch.
/// DB CHECK enforces id = 'singleton'. Missing row is a hard runtime error (never assume LEGACY).
enum CommerceFoundationCutoverMode {
  LEGACY
  FROZEN
  BACKFILLING
  FOUNDATION
  UNFROZEN

  @@map("commerce_foundation_cutover_mode")
}

model CommerceFoundationCutover {
  id           String                         @id
  mode         CommerceFoundationCutoverMode  @default(LEGACY)
  frozenAt     DateTime?                      @map("frozen_at")
  backfilledAt DateTime?                      @map("backfilled_at")
  foundationAt DateTime?                      @map("foundation_at")
  unfrozenAt   DateTime?                      @map("unfrozen_at")
  engineSha    String?                        @map("engine_sha")
  manifestHash String?                        @map("manifest_hash")
  updatedAt    DateTime                       @updatedAt @map("updated_at")

  @@map("commerce_foundation_cutover")
}

// Listing templates: reusable presets for common listing settings.
// Sellers can save templates from existing listings and apply them when creating new items.
model ListingTemplate {
  id                     String   @id @default(cuid())
  memberId               String   @map("member_id")
  name                   String

  // Common listing fields
  category               String?
  subcategory            String?
  condition              String?  @default("new")
  shippingPolicy         String?  @db.Text
  localDeliveryTerms     String?  @map("local_delivery_terms") @db.Text
  pickupTerms            String?  @map("pickup_terms") @db.Text
  shippingDisabled       Boolean  @default(false) @map("shipping_disabled")
  localDeliveryAvailable Boolean  @default(false) @map("local_delivery_available")
  inStorePickupAvailable Boolean  @default(false) @map("in_store_pickup_available")
  shippingCostCents      Int?     @map("shipping_cost_cents")
  shippingOptionId       String?  @map("shipping_option_id")
  localDeliveryFeeCents  Int?     @map("local_delivery_fee_cents")

  // Variants template: e.g. { name: "Size", options: ["S", "M", "L", "XL"] }
  variantsTemplate       Json?    @map("variants_template")

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shippingOption ShippingOption? @relation(fields: [shippingOptionId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@map("listing_template")
}

/// Reusable package template (name + inches + weight).
model ShippingOption {
  id              String    @id @default(cuid())
  memberId        String    @map("member_id")
  name            String
  lengthIn        Float?    @map("length_in")
  widthIn         Float?    @map("width_in")
  heightIn        Float?    @map("height_in")
  weightOz        Float?    @map("weight_oz")
  /// INW checkout / domestic flat rate. Null when calculated or unknown. 0 = free.
  shippingCostCents Int?    @map("shipping_cost_cents")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  member           Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  storeItems       StoreItem[]
  listingTemplates ListingTemplate[]

  @@index([memberId, archivedAt])
  @@map("shipping_option")
}

// Storefront orders
model StoreOrder {
  id                      String   @id @default(cuid())
  buyerId                 String   @map("buyer_id")
  sellerId                String   @map("seller_id")
  totalCents              Int      @map("total_cents")
  shippingCostCents       Int      @default(0) @map("shipping_cost_cents")
  subtotalCents           Int      @map("subtotal_cents")
  taxCents                Int      @default(0) @map("tax_cents")
  /// 1% of item subtotal only; withheld for compliance (see Terms §7.9)
  salesTaxReserveCents    Int      @default(0) @map("sales_tax_reserve_cents")
  /// NWC platform fee on pre-tax order total (5% with minimum)
  platformFeeCents        Int      @default(0) @map("platform_fee_cents")
  /// Stripe Connect transfer to seller after platform collects payment (facilitator flow)
  stripeSellerTransferId  String?  @map("stripe_seller_transfer_id")
  status                  String   @default("pending") // pending | paid | shipped | delivered | refunded | canceled
  shippingAddress         Json?    @map("shipping_address") // { street, city, state, zip }
  localDeliveryDetails    Json?    @map("local_delivery_details") // { firstName, lastName, phone, email?, deliveryAddress, note, termsAcceptedAt, availableDropOffTimes? }
  deliveryConfirmedAt     DateTime? @map("delivery_confirmed_at") // seller marked delivered (local delivery)
  deliveryBuyerConfirmedAt DateTime? @map("delivery_buyer_confirmed_at")
  pickupSellerConfirmedAt DateTime? @map("pickup_seller_confirmed_at")
  pickupBuyerConfirmedAt  DateTime? @map("pickup_buyer_confirmed_at")
  stripePaymentIntentId   String?  @map("stripe_payment_intent_id")
  stripeCheckoutSessionId String?  @map("stripe_checkout_session_id")
  stripeRefundId          String?  @map("stripe_refund_id")
  refundRequestedAt       DateTime? @map("refund_requested_at")
  refundReason            String?   @map("refund_reason")
  refundInitiatedAt       DateTime? @map("refund_initiated_at")
  refundCompletedAt       DateTime? @map("refund_completed_at")
  cancelReason            String?   @map("cancel_reason") // Changed my mind | Didn't mean to order | Order Arrived Damaged | Wrong Item Delivered | Other
  cancelNote              String?   @map("cancel_note") @db.Text // Optional note for seller
  inventoryRestoredAt     DateTime? @map("inventory_restored_at") // When inventory was restored after a cancel
  /// Nullable for historical orders. Live reservation rows require a non-null attempt.
  checkoutAttemptId       String?   @map("checkout_attempt_id")
  /// Compatibility default PENDING; not proof the order used the reservation protocol.
  commerceStatus          CommerceStatus @default(PENDING) @map("commerce_status")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  buyer   Member     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  Member     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  checkoutAttempt CheckoutAttempt? @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  shipments Shipment[]
  storeReturns StoreReturn[]
  reservations InventoryReservation[]
  refundOperations RefundOperation[]
  transferOperation TransferOperation?
  sellerReturnEntitlementOperation SellerReturnEntitlementOperation?
  packageWeightOz  Float?   @map("package_weight_oz")
  packageLengthIn  Float?   @map("package_length_in")
  packageWidthIn   Float?   @map("package_width_in")
  packageHeightIn Float?   @map("package_height_in")
  shippedWithOrderId String? @map("shipped_with_order_id") // When shipped as part of combined shipment

  @@unique([id, checkoutAttemptId])
  @@unique([id, sellerId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@index([checkoutAttemptId])
}

model Shipment {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  /// outbound | return | replacement
  kind            String   @default("outbound")
  supersededAt    DateTime? @map("superseded_at")
  carrier         String   // USPS, FedEx, UPS
  service         String   // e.g. Priority, Ground
  trackingNumber  String?  @map("tracking_number")
  labelUrl        String?  @map("label_url")
  labelCostCents  Int      @map("label_cost_cents")
  nwcFeeCents     Int      @default(0) @map("nwc_fee_cents") // 1.5% NWC shipping fee
  status          String   @default("created") // created | shipped
  weightOz        Float    @map("weight_oz")
  lengthIn        Float    @map("length_in")
  widthIn         Float    @map("width_in")
  heightIn        Float    @map("height_in")
  shippoTransactionId String? @map("shippo_transaction_id") // Shippo transaction object_id after label purchase
  shippoOrderId   String?  @map("shippo_order_id") // Shippo order id from ORDER_CREATED; pass as object_id to Elements for re-print
  /// Latest carrier status from Shippo track poll/webhook (UNKNOWN | TRANSIT | DELIVERED | ...).
  trackingStatus  String?  @map("tracking_status")
  createdAt       DateTime @default(now()) @map("created_at")

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeReturn StoreReturn? @relation("StoreReturnShipment")

  @@index([orderId, kind])
  @@index([orderId, supersededAt])
}

/// Buyer/seller return workflow for a storefront order (one active return at a time).
model StoreReturn {
  id                   String    @id @default(cuid())
  orderId              String    @map("order_id")
  /// requested | awaiting_return | in_transit | received | refunded | declined | canceled
  status               String    @default("requested")
  reason               String?
  note                 String?   @db.Text
  requireReturn        Boolean   @default(true) @map("require_return")
  /// Snapshot of seller chargeReturnShipping at approve time.
  chargeReturnShipping Boolean   @default(false) @map("charge_return_shipping")
  refundAmountCents    Int?      @map("refund_amount_cents")
  returnLabelCostCents Int       @default(0) @map("return_label_cost_cents")
  declineReason        String?   @map("decline_reason") @db.Text
  requestedAt          DateTime  @default(now()) @map("requested_at")
  approvedAt           DateTime? @map("approved_at")
  receivedAt           DateTime? @map("received_at")
  refundedAt           DateTime? @map("refunded_at")
  declinedAt           DateTime? @map("declined_at")
  returnShipmentId     String?   @unique @map("return_shipment_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  order          StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnShipment Shipment?  @relation("StoreReturnShipment", fields: [returnShipmentId], references: [id], onDelete: SetNull)
  sellerReturnEntitlementOperation SellerReturnEntitlementOperation?

  @@unique([id, orderId], map: "StoreReturn_id_order_id_key")
  @@index([orderId, status])
  @@index([status])
}

// Storefront order line items
model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String   @map("order_id")
  storeItemId          String   @map("store_item_id")
  quantity             Int
  priceCentsAtPurchase Int      @map("price_cents_at_purchase")
  variant              Json?    // selected variant if applicable
  fulfillmentType      String?  @map("fulfillment_type") // ship | local_delivery | pickup
  pickupDetails        Json?    @map("pickup_details") // snapshot at checkout from cart
  createdAt            DateTime @default(now()) @map("created_at")

  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeItem StoreItem  @relation(fields: [storeItemId], references: [id], onDelete: Restrict)
  /// Nullable for historical rows. Composite (variantId, storeItemId) is enforced in M1 SQL.
  variantId String? @map("variant_id")
  storeVariant StoreVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryEvents InventoryEvent[]
  reservation InventoryReservation?
  refundOperations RefundOperation[]

  @@unique([id, orderId])
  @@unique([id, storeItemId])
  @@unique([id, variantId, storeItemId])
  @@index([variantId])
}

// Community Resale - make offer on resale items
model ResaleOffer {
  id               String    @id @default(cuid())
  storeItemId      String    @map("store_item_id")
  buyerId          String    @map("buyer_id")
  amountCents      Int       @map("amount_cents")
  message          String?   @db.Text
  status           String    @default("pending") // pending | accepted | declined | countered | expired
  sellerResponse   String?   @map("seller_response") @db.Text
  counterAmountCents Int?   @map("counter_amount_cents") // seller's counter offer
  finalAmountCents Int?    @map("final_amount_cents") // agreed price when accepted
  acceptedAt       DateTime? @map("accepted_at")
  checkoutDeadlineAt DateTime? @map("checkout_deadline_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  respondedAt      DateTime? @map("responded_at")

  storeItem StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  buyer     Member    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cartItem  CartItem?
  chatMessages ResaleMessage[]

  @@index([storeItemId])
  @@index([buyerId])
  @@map("resale_offer")
}

// Community Resale - one thread per item per buyer
model ResaleConversation {
  id          String   @id @default(cuid())
  storeItemId String   @map("store_item_id")
  buyerId     String   @map("buyer_id")
  sellerId    String   @map("seller_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")

  storeItem StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Cascade)
  buyer     Member    @relation("ResaleConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    Member    @relation("ResaleConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  ResaleMessage[]

  @@unique([storeItemId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
  @@map("resale_conversation")
}

model ResaleMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  resaleOfferId  String?  @map("resale_offer_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ResaleConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Member             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  resaleOffer  ResaleOffer?       @relation(fields: [resaleOfferId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([resaleOfferId])
  @@map("resale_message")
}

// Direct messaging between members; non-friends create "pending" (message request).
model DirectConversation {
  id                    String    @id @default(cuid())
  memberAId              String    @map("member_a_id")
  memberBId              String    @map("member_b_id")
  status                 String    @default("accepted") // accepted | pending (message request)
  requestedByMemberId    String?   @map("requested_by_member_id") // who sent the first message (for pending)
  memberALastReadAt      DateTime? @map("member_a_last_read_at")
  memberBLastReadAt      DateTime? @map("member_b_last_read_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  memberA Member @relation("DirectConversationMemberA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB Member @relation("DirectConversationMemberB", fields: [memberBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([memberAId, memberBId])
  @@index([memberAId])
  @@index([memberBId])
  @@index([status])
  @@map("direct_conversation")
}

model DirectMessage {
  id                String   @id @default(cuid())
  conversationId    String   @map("conversation_id")
  senderId          String   @map("sender_id")
  content           String   @db.Text
  sharedContentType String?  @map("shared_content_type") // post | blog | store_item | business | coupon | reward | photo | event
  sharedContentId   String?  @map("shared_content_id")
  sharedContentSlug String?  @map("shared_content_slug") // for blog, business, store_item URL
  createdAt         DateTime @default(now()) @map("created_at")

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Member             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  likes        DirectMessageLike[]
  reactions    DirectMessageReaction[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("direct_message")
}

model DirectMessageLike {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  memberId  String   @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId])
  @@index([memberId])
  @@map("direct_message_like")
}

model DirectMessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  memberId  String   @map("member_id")
  emoji     String   // heart | thumbsup | laugh | etc.
  createdAt DateTime @default(now()) @map("created_at")

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([memberId])
  @@map("direct_message_reaction")
}

// Group chat - multiple members
model GroupConversation {
