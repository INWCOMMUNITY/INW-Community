  event     String   // pageview | app_open | web_vitals
  source    String   // web | ios | android
  path      String?  // URL path for pageview
  name      String?  // web vitals metric name: LCP | FID | CLS
  value     Float?   // metric value
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, source])
  @@index([createdAt])
  @@map("analytics_event")
}

model MemberBlock {
  id          String   @id @default(cuid())
  blockerId   String   @map("blocker_id")
  blockedId   String   @map("blocked_id")
  createdAt   DateTime @default(now()) @map("created_at")

  blocker Member @relation("blocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Member @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
